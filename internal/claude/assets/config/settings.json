{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Agent(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Grep(*)",
      "Glob(*)",
      "NotebookEdit(*)",
      "TodoWrite(*)",
      "Skill(*)",
      "mcp__github__search_code",
      "mcp__github__get_file_contents",
      "mcp__github__search_issues",
      "mcp__github__add_issue_comment",
      "mcp__github__issue_write",
      "mcp__github__issue_read",
      "PowerShell(*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$p = New-Object System.Media.SoundPlayer 'C:\\Windows\\Media\\Alarm01.wav'; $p.PlaySync()\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$p = New-Object System.Media.SoundPlayer 'C:\\Windows\\Media\\Ring01.wav'; $p.PlaySync(); Start-Sleep -Milliseconds 250; $p.PlaySync()\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
