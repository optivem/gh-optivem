{
  "name": "gh-optivem",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=gh-optivem-workspace,target=/workspaces,type=volume",
  "workspaceFolder": "/workspaces/gh-optivem",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.25"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "github.vscode-github-actions",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "mounts": [
    "source=gh-optivem-gh-config,target=/home/vscode/.config/gh,type=volume",
    "source=gh-optivem-claude-config,target=/home/vscode/.claude,type=volume",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude/commands,target=/home/vscode/.claude/commands,type=bind,readonly"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "remoteEnv": {
    "DOCKERHUB_USERNAME": "${localEnv:DOCKERHUB_USERNAME}",
    "DOCKERHUB_TOKEN": "${localEnv:DOCKERHUB_TOKEN}",
    "GHCR_TOKEN": "${localEnv:GHCR_TOKEN}",
    "REPO_TOKEN": "${localEnv:REPO_TOKEN}",
    "SONAR_TOKEN": "${localEnv:SONAR_TOKEN}",
    "WORKFLOW_TOKEN": "${localEnv:WORKFLOW_TOKEN}"
  },
  "postCreateCommand": "gh-optivem-bootstrap",
  "postAttachCommand": "if [ -f .devcontainer/fix-git-credential-helpers.sh ]; then bash .devcontainer/fix-git-credential-helpers.sh; fi",
  "remoteUser": "vscode"
}
